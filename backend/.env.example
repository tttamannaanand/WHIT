# Copy this file to .env and fill in real values before running the server.

# Port the API listens on
PORT=4000

# Secret used to sign session JWTs — generate with `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string

# RevenueCat project settings (from app.revenuecat.com)
# Secret API key (starts with sk_) — used server-side to call the REST API.
# NEVER put this in the mobile app. Dashboard > Project settings > API keys.
REVENUECAT_SECRET_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The entitlement identifier you created in RevenueCat (e.g. "premium")
REVENUECAT_ENTITLEMENT_ID=premium

# The Authorization header value you set on the Webhook in the RevenueCat
# dashboard (Project settings > Integrations > Webhooks > Authorization header).
# The backend rejects any webhook call that doesn't send this exact value.
REVENUECAT_WEBHOOK_AUTH_HEADER=replace-with-a-long-random-string

# SQLite file location
DB_PATH=./data/whit.db
